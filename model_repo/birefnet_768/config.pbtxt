name: "birefnet_768"
platform: "tensorrt_plan"
max_batch_size: 4

input [
  {
    name: "input_image"
    data_type: TYPE_FP32
    dims: [ 3, 768, 768 ]
  }
]
output [
  {
    name: "output_logits"
    data_type: TYPE_FP32
    dims: [ 1, 768, 768 ]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# 预热——TRT 首次推理构建 CUDA kernel 耗时数百毫秒
model_warmup [
  {
    name: "warmup_sample"
    batch_size: 1
    inputs: {
      key: "input_image"
      value: {
        data_type: TYPE_FP32
        dims: [ 3, 768, 768 ]
        random_data: true
      }
    }
  }
]
